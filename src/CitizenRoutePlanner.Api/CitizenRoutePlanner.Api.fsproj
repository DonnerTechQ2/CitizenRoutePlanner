<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Services/AppStateService.fs" />
    <Compile Include="Hubs/RouteHub.fs" />
    <Compile Include="Services/LogWatcherService.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CitizenRoutePlanner.Core\CitizenRoutePlanner.Core.fsproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\locations-positions.json" CopyToOutputDirectory="PreserveNewest">
      <Link>locations-positions.json</Link>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FSharp.SystemTextJson" Version="1.4.36" />
  </ItemGroup>

</Project>
